# ---- Data sources ----
# ОБЯЗАТЕЛЬНО. Financial Modeling Prep (основной источник). Тариф Starter+.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# ОБЯЗАТЕЛЬНО. SEC EDGAR не требует ключа, но обязателен корректный User-Agent.
# Формат: "<название проекта> <контактный email>". С плейсхолдером example.com
# сервисы не запустятся — впишите реальный email.
SEC_USER_AGENT=switch-trading-mvp your-email@example.com
SEC_BASE_URL=https://data.sec.gov

# Alpaca Market Data (резервный источник котировок/баров).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets
# Фид Alpaca: iex — бесплатный (объёмы только биржи IEX; порог ликвидности в
# резервном режиме тогда не проверяется), sip — все биржи США (платный тариф).
ALPACA_DATA_FEED=iex

# Finnhub (второй резерв / news sentiment).
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ---- Telegram ----
# ОБЯЗАТЕЛЬНО для бота.
TELEGRAM_BOT_TOKEN=
# ОБЯЗАТЕЛЬНО: Telegram ID пользователей с доступом к боту (через запятую).
TELEGRAM_ALLOWED_IDS=
# Открытый доступ для всех пользователей Telegram — только осознанно: true.
TELEGRAM_ALLOW_PUBLIC=false

# ---- LLM (AI Explanation) ----
# Провайдер по умолчанию согласуется до деплоя: claude | openai
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Database ----
POSTGRES_USER=switch
# ОБЯЗАТЕЛЬНО: надёжный пароль БД.
POSTGRES_PASSWORD=
POSTGRES_DB=switch_trading
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Полный async DSN (если задан — переопределяет составные поля выше).
DATABASE_URL=

# ---- Runtime ----
# Часовой пояс торговых расчётов (ТЗ раздел 0).
MARKET_TIMEZONE=America/New_York
# Тайм-аут HTTP-клиентов источников, сек.
HTTP_TIMEOUT_SECONDS=15
# Кол-во попыток retry с экспоненциальным backoff.
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
# Фоновая проверка доступности источников для /health, сек (0 — выключить).
HEALTH_PROBE_INTERVAL_SECONDS=600
# Срок хранения ленты проверок источников (source_health), дней.
SOURCE_HEALTH_RETENTION_DAYS=30
