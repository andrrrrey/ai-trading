# ---- Data sources ----
# Financial Modeling Prep (основной источник). Тариф Starter+ для fundamentals/news.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# SEC EDGAR не требует ключа, но обязателен корректный User-Agent (см. ТЗ 6.2).
# Формат: "<название проекта> <контактный email>". Впишите свой реальный email.
SEC_USER_AGENT=switch-trading-mvp your-email@example.com
SEC_BASE_URL=https://data.sec.gov

# Alpaca Market Data (резервный источник котировок/баров).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets

# Finnhub (второй резерв / news sentiment).
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Опциональный whitelist Telegram ID (через запятую) для приватного доступа; пусто = открыто.
TELEGRAM_ALLOWED_IDS=

# ---- LLM (AI Explanation) ----
# Провайдер по умолчанию согласуется до деплоя: claude | openai
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Database ----
POSTGRES_USER=switch
POSTGRES_PASSWORD=switch
POSTGRES_DB=switch_trading
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Полный async DSN (если задан — переопределяет составные поля выше).
DATABASE_URL=

# ---- Runtime ----
# Часовой пояс торговых расчётов (ТЗ раздел 0).
MARKET_TIMEZONE=America/New_York
# Тайм-аут HTTP-клиентов источников, сек.
HTTP_TIMEOUT_SECONDS=15
# Кол-во попыток retry с экспоненциальным backoff.
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
